{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "kguardian",
  "colors": {
    "primary": "#4E3AD9",
    "light": "#7C6FF0",
    "dark": "#3B2BA8"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "installation",
              "architecture"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/overview",
              "concepts/ebpf-monitoring",
              "concepts/network-policies",
              "concepts/peer-attribution",
              "concepts/audit-network-policy",
              "concepts/seccomp-profiles",
              "concepts/compute-contention",
              "concepts/policy-as-code"
            ]
          },
          {
            "group": "User Guides",
            "pages": [
              "guides/generating-network-policies",
              "guides/mcp-endpoint",
              "guides/distributing-seccomp-profiles",
              "guides/compute-gauges"
            ]
          },
          {
            "group": "Policy Gallery",
            "pages": [
              "policy-gallery/index",
              "policy-gallery/nginx",
              "policy-gallery/postgres",
              "policy-gallery/kube-dns",
              "policy-gallery/prometheus",
              "policy-gallery/istio-sidecar",
              "policy-gallery/go-microservice"
            ]
          },
          {
            "group": "CLI Reference",
            "pages": [
              "cli/overview",
              "cli/gen-networkpolicy",
              "cli/gen-seccomp",
              "cli/compute-findings"
            ]
          },
          {
            "group": "CRD Reference",
            "pages": [
              "reference/crds/seccompprofile"
            ]
          },
          {
            "group": "Configuration Reference",
            "pages": [
              "reference/compute"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "advanced/troubleshooting",
              "telemetry"
            ]
          },
          {
            "group": "Roadmap",
            "pages": [
              "roadmap/future-resources",
              "roadmap/planned-features"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Broker API",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/endpoints/pods",
              "api-reference/endpoints/traffic",
              "api-reference/endpoints/syscalls",
              "api-reference/endpoints/seccomp",
              "api-reference/endpoints/services",
              "api-reference/endpoints/audit-verdicts",
              "api-reference/endpoints/version",
              "api-reference/endpoints/environment"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/kguardian-dev/kguardian",
          "icon": "github"
        },
        {
          "anchor": "Community",
          "href": "https://github.com/kguardian-dev/kguardian/discussions",
          "icon": "comments"
        },
        {
          "anchor": "Releases",
          "href": "https://github.com/kguardian-dev/kguardian/releases",
          "icon": "tag"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": false
  },
  "navbar": {
    "links": [
      {
        "label": "Try kguardian",
        "href": "https://kguardian.dev/quickstart"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Star on GitHub \u2b50",
      "href": "https://github.com/kguardian-dev/kguardian"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/kguardian-dev/kguardian"
    }
  },
  "seo": {
    "indexHiddenPages": false
  },
  "analytics": {
    "posthog": {
      "apiKey": "your-posthog-key-here"
    }
  }
}